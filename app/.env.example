# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Firebase ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=      # From Firebase console → Project settings
FIREBASE_CLIENT_EMAIL=    # From service account JSON → client_email
FIREBASE_PRIVATE_KEY=     # From service account JSON → private_key (include the full -----BEGIN/END----- block)
